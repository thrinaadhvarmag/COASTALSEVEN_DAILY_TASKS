APP_NAME=E-Commerce Backend API
APP_VERSION=2.1.0
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_test
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
LOGIN_OTP_EXPIRE_MINUTES=5
LOGIN_OTP_RESEND_SECONDS=60
LOGIN_OTP_MAX_ATTEMPTS=5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=uploads/products
MAX_IMAGE_SIZE_MB=5
PRODUCT_CACHE_SECONDS=300
