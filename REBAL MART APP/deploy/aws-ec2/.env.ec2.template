# ==============================================================================
# REBEL MART — AWS EC2 ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.ec2` on your EC2 instance:
#   cp .env.ec2.template .env.ec2
# Then edit the values with your actual production secrets:
#   nano .env.ec2
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false

# Domain & Public URLs (Replace with your EC2 Elastic IP or Custom Domain)
DOMAIN_NAME=your-domain.com
PUBLIC_API_URL=/api

# Database Credentials (PostgreSQL)
POSTGRES_USER=rebelmart_user
POSTGRES_PASSWORD=replace_with_a_super_strong_password_123!
POSTGRES_DB=rebelmart_prod

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_random_64_character_hex_string_for_jwt_auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Resend HTTPS REST API (Recommended for 100% reliable cloud email delivery)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="Rebel Mart"

# Optional SMTP Fallback (If not using Resend API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Rebel Mart Official"

# Razorpay Payment Gateway (Optional / Production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Initial Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@rebelmart.com
ADMIN_DEFAULT_PASSWORD=ChangeThisAdminPassword2026!
