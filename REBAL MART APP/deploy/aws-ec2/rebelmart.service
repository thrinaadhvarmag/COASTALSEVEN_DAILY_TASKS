[Unit]
Description=Rebel Mart Official Application Stack (Docker Compose)
Requires=docker.service
After=docker.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/COASTALSEVEN_DAILY_TASKS/REBAL MART APP/deploy/aws-ec2
ExecStart=/usr/bin/docker compose -f docker-compose.ec2.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.ec2.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.ec2.yml restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
